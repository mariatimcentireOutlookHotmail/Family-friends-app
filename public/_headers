# Sent with every page and file of the website (Cloudflare reads this file).
# - X-Robots-Tag: keep the site out of Google and other search engines.
# - The rest: standard browser protections (no framing by other sites, etc.).
/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
