# Copy to .env and fill in. .env is git-ignored; this file is committed.
# Find both values in the Supabase dashboard: Project Settings → API (or API Keys).
#
# EXPO_PUBLIC_ values are bundled into the app and visible to anyone, so only
# the project URL and the PUBLIC key belong here. Supabase calls it the
# "publishable key" (newer projects) or the "anon key" (older ones); either
# variable name below works.
# NEVER put the service_role / secret key in this app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# The website's address. Invite and tree-link messages use it for their links.
# Optional here; the hosted build sets it (https://myorbit.click).
EXPO_PUBLIC_WEB_URL=https://myorbit.click
