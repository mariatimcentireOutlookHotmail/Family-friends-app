{
  "expo": {
    "name": "MyOrbit",
    "slug": "family-friends-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1E1B4B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "MyOrbit uses your photos so you can add pictures of your family.",
          "cameraPermission": "MyOrbit uses the camera so you can take pictures of your family.",
          "microphonePermission": false
        }
      ],
      "expo-notifications"
    ],
    "scheme": "myorbit",
    "experiments": {
      "typedRoutes": true
    }
  }
}
